{
  "name": "seo-buddy",
  "version": "1.0.0",
  "description": "Total Rank System SEO Dashboard for Best Day Fitness",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "node scripts/prepare-state.mjs",
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser": "node scripts/browser-acceptance.cjs",
    "test:unit": "node --test --test-concurrency=1 test/architecture-helpers.test.mjs",
    "test:contracts": "node --test --test-concurrency=1 test/provider-contract.test.mjs test/integration.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "backup": "node scripts/backup-state.mjs",
    "db:migrate": "node scripts/migrate-database.mjs"
  },
  "keywords": [
    "seo",
    "gohighlevel",
    "google-search-console",
    "indexing-api",
    "gemini"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "2.12.0",
    "body-parser": "^1.20.2",
    "compression": "1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^137.0.0",
    "pg": "8.23.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright": "1.62.1"
  }
}
